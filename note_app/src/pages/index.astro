---
import MainLayout from '../layouts/MainLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import NoteList from '../components/NoteList.astro';
import NoteForm from '../components/NoteForm.astro';
import FloatingActionButton from '../components/FloatingActionButton.astro';
---

<MainLayout title="NoteEase - Simple Note Taking App">
  <div class="app-container">
    <SearchBar />
    <CategoryFilter />
    <NoteList />
    <NoteForm />
    <FloatingActionButton />
  </div>
</MainLayout>

<style>
  .app-container {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>

<script>
  // Import the main script for client-side functionality
  import '../scripts/main.js';
</script>
